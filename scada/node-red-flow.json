        "func": "let cmd = String(msg.payload).trim();\n\nlet auto_mode = 0;\nlet manual_cmd = 0;\n\nif (cmd === \"ON\") {\n    manual_cmd = 1;\n} else if (cmd === \"OFF\") {\n    manual_cmd = 0;\n} else {\n    return null;\n}\n\nlet msg1 = {\n    payload: {\n        value: auto_mode,\n        fc: 6,\n        unitid: 1,\n        address: 6,\n        quantity: 1\n    }\n};\n\nlet msg2 = {\n    payload: {\n        value: manual_cmd,\n        fc: 6,\n        unitid: 1,\n        address: 7,\n        quantity: 1\n    }\n};\n\nreturn [msg1, msg2];",
