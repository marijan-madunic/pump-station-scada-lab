        "name": "comms_lost",
        "func": "let wasLost = flow.get(\"comms_lost_state\") || false;\n\nif (!wasLost) {\n    flow.set(\"comms_lost_state\", true);\n    msg.payload = [{\n        event: \"COMMUNICATION LOST\",\n        severity: \"ERROR\"\n    }];\n    return msg;\n}\n\nreturn null;",
