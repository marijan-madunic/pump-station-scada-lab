        "type": "function",
        "z": "9f14d142adfac103",
        "g": "c656f749c55d66ad",
        "name": "append_log",
        "func": "let newRows = msg.payload;\n\n// ako slučajno dođe jedan objekt umjesto array-a\nif (!Array.isArray(newRows)) {\n    newRows = [newRows];\n}\n\n// uzmi postojeći log iz flow contexta\nlet logs = flow.get(\"alarm_logs\") || [];\n\n// dodaj nove redove na početak\nlogs = newRows.concat(logs);\n\n// ograniči na zadnjih 50 zapisa\nif (logs.length > 50) {\n    logs = logs.slice(0, 50);\n}\n\n// spremi natrag\nflow.set(\"alarm_logs\", logs);\n\n// pošalji cijelu listu tablici\nmsg.payload = logs;\nreturn msg;",
