        "type": "function",
        "z": "9f14d142adfac103",
        "g": "c656f749c55d66ad",
        "name": "detect_events",
        "func": "let p = msg.payload;\n\nif (typeof p === \"string\") {\n    p = JSON.parse(p);\n}\n\nlet prevLow = context.get(\"prevLow\") || 0;\nlet prevHigh = context.get(\"prevHigh\") || 0;\n\nlet events = [];\n\nif (p.alarm_low === 1 && prevLow === 0) {\n    events.push({\n        event: \"LOW LEVEL ALARM\",\n        severity: \"WARN\"\n    });\n}\n\nif (p.alarm_high === 1 && prevHigh === 0) {\n    events.push({\n        event: \"HIGH LEVEL ALARM\",\n        severity: \"WARN\"\n    });\n}\n\ncontext.set(\"prevLow\", p.alarm_low);\ncontext.set(\"prevHigh\", p.alarm_high);\n\nif (events.length === 0) {\n    return null;\n}\n\nmsg.payload = events;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
