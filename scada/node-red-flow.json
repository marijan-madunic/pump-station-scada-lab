    {
        "id": "8d803a3aa6ac7f0c",
        "type": "function",
        "z": "9f14d142adfac103",
        "g": "c656f749c55d66ad",
        "name": "format_log_row",
        "func": "let events = msg.payload;\n\nif (!Array.isArray(events)) {\n    events = [events];\n}\n\nlet rows = events.map(e => {\n    let sev = e.severity || \"WARN\";\n    let color = \"black\";\n\n    if (sev === \"ERROR\") {\n        color = \"red\";\n    } else if (sev === \"WARN\") {\n        color = \"orange\";\n    } else if (sev === \"INFO\") {\n        color = \"blue\";\n    }\n\n    return {\n        time: new Date().toLocaleString(),\n        alarm: e.event,\n        severity: `<span style=\"color:${color}; font-weight:bold;\">${sev}</span>`\n    };\n});\n\nmsg.payload = rows;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
